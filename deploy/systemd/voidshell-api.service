[Unit]
Description=voidshell API
After=network.target

[Service]
Type=simple
User=voidshell
WorkingDirectory=/opt/voidshell/api
Environment=NODE_ENV=production
Environment=VOIDSHELL_DB=/var/lib/voidshell/db.json
Environment=PORT=3000
# Secrets live here, not above: unit files are world-readable, and a key in
# `Environment=` shows up in `systemctl show` for any user on the box.
# Create /etc/voidshell.env as root, chmod 600, containing:
#   ANTHROPIC_API_KEY=sk-ant-...
# The dash makes it optional — without it the API still starts, and the
# decision route reports itself unavailable so the client falls back to its
# deterministic simulator rather than erroring.
EnvironmentFile=-/etc/voidshell.env
# server.js, not index.js. index.js exports build() and starts nothing — the
# split is what keeps a test from booting a listener on the production
# database. Pointing systemd at it would start a process that exits silently.
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5

# SIGTERM drains the write queue before exiting, so a deploy restart cannot
# land in the middle of somebody's dashboard save. Give it room to finish.
KillSignal=SIGTERM
TimeoutStopSec=20

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The one writable path. ProtectSystem=strict makes everything else read-only,
# which is the point: a compromised API process cannot rewrite its own code.
ReadWritePaths=/var/lib/voidshell

[Install]
WantedBy=multi-user.target
