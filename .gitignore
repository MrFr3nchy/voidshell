# dependencies
node_modules/

# build output
dist/

# local env
.env
.env.*.local

# misc
.DS_Store
*.log

# Harness bundles. Every check in CI is an esbuild bundle dropped in the repo
# root and run once; three of them were listed here by name as they were added,
# which meant each new harness left an untracked file until somebody noticed.
*-smoke.mjs
*-checks.mjs
*-perft.mjs
smoke.mjs
emit.mjs

# CLI: per-checkout droplet settings and the local dev database
.voidshell.json
.voidshell-dev/

# Per-machine settings: which folder /projects is a view of. Deliberately not
# committed — it is the whole point that this differs between machines.
voidshell.local.json
