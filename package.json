{
  "name": "voidshell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A spatial WebOS core: a modular microkernel that runs apps as glass panels floating in a shader-lit void.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @voidshell/ui",
    "build": "npm run build --workspace @voidshell/ui",
    "preview": "npm run preview --workspace @voidshell/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "voidshell": "node packages/cli/bin/voidshell.mjs"
  }
}
